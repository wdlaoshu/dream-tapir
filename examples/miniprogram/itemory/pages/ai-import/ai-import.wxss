/* 识图录入 */

.pick-box {
  margin: 24rpx;
  height: 320rpx;
  border-radius: 28rpx;
  border: 2rpx dashed var(--line);
  background: var(--panel);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.pick-emoji { font-size: 76rpx; }
.pick-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.pick-sub { font-size: 24rpx; color: var(--ink-2); padding: 0 40rpx; text-align: center; line-height: 1.5; }

.preview-wrap {
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--panel-2);
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview { width: 100%; height: 420rpx; }

.busy {
  margin: 24rpx;
  padding: 32rpx;
  background: var(--panel);
  border-radius: 24rpx;
  text-align: center;
}

.busy-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.busy-sub { margin-top: 10rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.5; }

.callout {
  margin: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 22rpx;
  background: var(--panel);
}

.callout.bad { border-left: 8rpx solid var(--danger); }
.callout.warn { border-left: 8rpx solid var(--warn); }

.callout-title { font-size: 28rpx; font-weight: 600; color: var(--ink); }
.callout-text { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.55; }
.callout-line { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.5; }

.group-hint { font-size: 22rpx; color: var(--ink-3); }

.notes-sub { white-space: normal; line-height: 1.5; }

.actions {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
}

.actions button { flex: 1; }

.empty-action { margin-top: 32rpx; }

button::after { border: none; }

.sheet-foot {
  margin: 24rpx 4rpx 20rpx;
}
