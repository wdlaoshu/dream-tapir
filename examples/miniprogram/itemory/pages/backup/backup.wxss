/* 备份与导入 */

.sheet-tall { max-height: 88vh; }

.import-textarea {
  width: 100%;
  height: 320rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink);
  background: var(--panel-2);
  border-radius: 18rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.sheet-foot {
  margin: 24rpx 4rpx 20rpx;
}

button::after { border: none; }
