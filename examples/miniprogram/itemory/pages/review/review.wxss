/* 回顾 */

.year-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx 4rpx;
  box-sizing: border-box;
}

.year-bar .chip {
  display: inline-block;
  margin-right: 12rpx;
}

.year-head {
  padding: 26rpx 32rpx 6rpx;
}

.year-head-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--ink-3);
}

.review-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 10rpx 24rpx 0;
  padding: 20rpx 22rpx;
  background: var(--panel);
  border-radius: 22rpx;
}

.review-date {
  width: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.review-day {
  font-size: 34rpx;
  font-weight: 650;
  color: var(--ink);
  line-height: 1.1;
}

.review-month {
  font-size: 20rpx;
  color: var(--ink-3);
}

.review-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--panel-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.review-cover { width: 88rpx; height: 88rpx; }

.review-emoji { font-size: 46rpx; line-height: 1; }

.review-main { flex: 1; min-width: 0; }

.review-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-exit-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.empty-action {
  margin-top: 32rpx;
}

button::after { border: none; }
