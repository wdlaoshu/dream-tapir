.form-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.form-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 8rpx 6rpx;
}

.form-bar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.form-bar-btn {
  font-size: 28rpx;
  color: var(--ink-2);
  padding: 10rpx 12rpx;
}

.form-bar-save {
  color: var(--accent);
  font-weight: 600;
}

.ph {
  color: var(--ink-3);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 0 6rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.suggest-row,
.cat-row {
  white-space: nowrap;
  padding: 14rpx 4rpx 4rpx;
}

.suggest {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--field);
  font-size: 24rpx;
  color: var(--ink);
}

.cat-row .pill {
  margin-right: 12rpx;
  display: inline-flex;
}

.small-empty {
  padding: 40rpx 20rpx;
}

.danger-zone {
  margin-top: 40rpx;
}

.hero-icon {
  position: relative;
}

.hero-edit {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--panel-solid);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-2);
}

.icon-menu {
  margin: 10rpx 40rpx 0;
  background: var(--panel-solid);
  border-radius: 22rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
}

.icon-menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 27rpx;
  color: var(--ink);
}

.icon-menu-item + .icon-menu-item {
  border-top: 1rpx solid var(--line);
}

.tick {
  color: var(--accent);
}

.btn {
  gap: 10rpx;
}
