<import src="../../templates/tabbar.wxml" />

<view class="page {{theme}}">
  <view class="top">
    <view class="h1">账号</view>
    <view class="round-group">
      <view class="round" bindtap="openAdd">+</view>
      <view class="round" bindtap="openMenu">⋯</view>
    </view>
  </view>
  <view class="summary">{{summary}}</view>

  <view class="seg" wx:if="{{hasIdentities}}">
    <view
      wx:for="{{kinds}}"
      wx:key="key"
      class="seg-item {{item.on ? 'on' : ''}}"
      data-kind="{{item.key}}"
      bindtap="onKind"
    >
      <text>{{item.label}}</text>
      <text class="seg-count">{{item.count}}</text>
    </view>
  </view>

  <swiper
    wx:if="{{cards.length}}"
    class="swiper"
    current="{{cardIndex}}"
    bindchange="onCardChange"
    duration="220"
  >
    <swiper-item wx:for="{{cards}}" wx:key="id">
      <view class="swiper-item">
        <view class="card" style="{{item.cardStyle}}" data-id="{{item.id}}" bindtap="onCard">
          <view class="card-sheen"></view>
          <view class="card-top">
            <view class="card-kind">
              <text>{{item.title}}</text>
              <text wx:if="{{item.esim}}" class="tag">eSIM</text>
            </view>
            <view class="card-count"><text class="card-count-n">{{item.count}}</text>个网站与 App</view>
          </view>
          <view class="card-value">{{item.value}}</view>
          <view class="card-foot">
            <view class="card-note">{{item.note}}</view>
            <view class="stack">
              <text wx:if="{{item.more}}" class="stack-more">+{{item.more}}</text>
              <view
                wx:for="{{item.stack}}"
                wx:for-item="t"
                wx:key="id"
                class="stack-tile"
                style="background:{{t.bg}}"
              >{{t.letter}}</view>
            </view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="dots" wx:if="{{cards.length > 1}}">
    <view wx:for="{{cards}}" wx:key="id" class="dot {{index === cardIndex ? 'on' : ''}}"></view>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <view class="h2">从一个邮箱或手机号开始</view>
    <view class="sub empty-sub">每张卡片记着它注册、绑定过的网站与 App</view>
    <view class="btn" bindtap="onFirstAdd">添加邮箱或手机号</view>
  </view>

  <block wx:else>
    <view class="block-head">
      <view class="block-title">
        <view class="h2">{{gridTitle}}</view>
        <view class="sub" wx:if="{{gridSub}}">{{gridSub}}</view>
      </view>
      <view class="pill" bindtap="onGridAdd">+ 添加</view>
    </view>

    <view class="grid">
      <view
        wx:for="{{grid}}"
        wx:key="id"
        class="grid-item"
        data-id="{{item.id}}"
        bindtap="onGridItem"
      >
        <view class="tile" style="background:{{item.bg}}">{{item.letter}}</view>
        <view class="grid-name">{{item.name}}</view>
      </view>
      <view wx:if="{{moreCount}}" class="grid-item" bindtap="onMore">
        <view class="tile tile-more">+{{moreCount}}</view>
        <view class="grid-name">全部</view>
      </view>
      <view wx:if="{{!moreCount}}" class="grid-item" bindtap="onGridAdd">
        <view class="tile tile-add">+</view>
        <view class="grid-name">添加</view>
      </view>
    </view>
  </block>

  <template is="tabbar" data="{{active: active}}" />

  <view wx:if="{{addOpen}}" class="mask" bindtap="closeAdd"></view>
  <view wx:if="{{addOpen}}" class="popup">
    <view class="popup-head">
      <text>添加</text>
      <text class="popup-close" bindtap="closeAdd">关闭</text>
    </view>
    <view class="popup-body">
      <view class="row" bindtap="onAddIdentity">
        <view class="tile tile-sm" style="background:#0a84ff">@</view>
        <view class="row-main"><view class="row-title">邮箱、手机号或登录身份</view></view>
        <text class="chev">›</text>
      </view>
      <view class="row" bindtap="onAddAccount">
        <view class="tile tile-sm" style="background:#30d158">#</view>
        <view class="row-main"><view class="row-title">网站与 App</view></view>
        <text class="chev">›</text>
      </view>
      <view class="row" bindtap="onAddToken">
        <view class="tile tile-sm" style="background:#ff9f0a">K</view>
        <view class="row-main"><view class="row-title">密钥</view></view>
        <text class="chev">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{menuOpen}}" class="mask" bindtap="closeMenu"></view>
  <view wx:if="{{menuOpen}}" class="popup">
    <view class="popup-head">
      <text>更多</text>
      <text class="popup-close" bindtap="closeMenu">关闭</text>
    </view>
    <view class="popup-body">
      <view class="row" bindtap="onTogglePrivacy">
        <view class="row-main"><view class="row-title">{{privacyText}}</view></view>
      </view>
      <view class="row" bindtap="onCycleTheme">
        <view class="row-main">
          <view class="row-title">外观</view>
          <view class="row-sub">{{themeText}}</view>
        </view>
      </view>
      <view class="row" bindtap="onBackup">
        <view class="row-main"><view class="row-title">备份与导入</view></view>
        <text class="chev">›</text>
      </view>
      <view class="row" bindtap="onDemo">
        <view class="row-main"><view class="row-title">载入示例数据</view></view>
      </view>
      <view class="row" bindtap="onWipe">
        <view class="row-main"><view class="row-title row-danger">清空全部数据</view></view>
      </view>
    </view>
  </view>
</view>
