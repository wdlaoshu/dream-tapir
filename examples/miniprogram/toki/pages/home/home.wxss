.summary {
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 6rpx 8rpx 4rpx;
  line-height: 1.5;
}

.card-count-n {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ink-3);
}

.dot.on {
  background: var(--ink);
}

.empty-sub {
  padding: 0 30rpx;
}

.block-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 12rpx 14rpx;
}

.block-title {
  min-width: 0;
}

.pill-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--field);
  font-size: 24rpx;
  color: var(--ink);
  flex: none;
}

.tile-add {
  background: var(--field);
  color: var(--ink-3);
  border: 2rpx dashed var(--line);
}

.tile-add .ico {
  color: var(--ink-3);
}

.tile-more {
  background: var(--field);
  color: var(--ink-2);
  font-size: 24rpx;
}

.stack-tile {
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.identity-tile {
  background: linear-gradient(180deg, #56c6ff, #0a84ff);
}

.site-tile {
  background: linear-gradient(180deg, #d2f56a, #30d158);
}

.token-tile {
  background: linear-gradient(180deg, #ffdf5c, #ff9f0a);
}

.menu-ic {
  width: 56rpx;
  display: flex;
  justify-content: center;
  color: var(--ink-2);
}

.chev {
  color: var(--ink-3);
}

.popup-close {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 400;
}

.row-danger {
  color: var(--danger);
}
