.form-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.form-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 8rpx 6rpx;
}

.form-bar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.form-bar-btn {
  font-size: 28rpx;
  color: var(--ink-2);
  padding: 10rpx 12rpx;
}

.form-bar-save {
  color: var(--accent);
  font-weight: 600;
}

.ph {
  color: var(--ink-3);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 0 6rpx;
}

.hero-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.hero-sub {
  font-size: 25rpx;
  color: var(--ink-2);
}

.link-val {
  color: var(--ink);
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 25rpx;
}

.cat-row {
  white-space: nowrap;
  padding: 14rpx 4rpx 4rpx;
}

.cat-row .pill {
  margin-right: 12rpx;
  display: inline-flex;
}

.popup-search {
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.popup-close {
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 400;
}

.danger-zone {
  margin-top: 40rpx;
}
