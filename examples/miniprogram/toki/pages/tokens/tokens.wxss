.summary {
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 6rpx 12rpx 4rpx;
}

.empty-sub {
  padding: 0 30rpx;
}

.filter-n {
  font-size: 20rpx;
  opacity: 0.65;
  margin-left: 6rpx;
}

.token-rows {
  margin-top: 18rpx;
}

.token-row {
  align-items: flex-start;
  padding: 24rpx;
}

.tok-value {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  word-break: break-all;
}

.tok-value.shown {
  color: var(--ink);
}

.tok-acc {
  color: var(--ink-2);
}

.expired {
  color: var(--danger);
}

.soon {
  color: #ff9f0a;
}

.tok-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: none;
}

.tok-btn {
  font-size: 22rpx;
  color: var(--accent);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: var(--field);
  text-align: center;
}
