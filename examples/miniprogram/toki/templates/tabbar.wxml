<!-- 共用底部导航。小程序 tabBar 在 Web 容器里没有实现，所以四页各自渲染一份。 -->
<template name="tabbar">
  <view class="tabbar">
    <view class="tab {{active === 'home' ? 'on' : ''}}" data-tab="home" bindtap="onTab">
      <view class="ico ico-md ico-card"></view>
      <text>账号</text>
    </view>
    <view class="tab {{active === 'sites' ? 'on' : ''}}" data-tab="sites" bindtap="onTab">
      <view class="ico ico-md ico-grid"></view>
      <text>网站</text>
    </view>
    <view class="tab {{active === 'tokens' ? 'on' : ''}}" data-tab="tokens" bindtap="onTab">
      <view class="ico ico-md ico-key"></view>
      <text>密钥</text>
    </view>
    <view class="tab {{active === 'graph' ? 'on' : ''}}" data-tab="graph" bindtap="onTab">
      <view class="ico ico-md ico-graph"></view>
      <text>关系图</text>
    </view>
  </view>
</template>
